# Database
DATABASE_URL=postgresql://shayfinance:shayfinance_dev@localhost:5432/shayfinance

# Encryption key for bank credentials (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# App password (bcrypt hash — generate with: node -e "require('bcrypt').hash('yourpassword', 12).then(console.log)")
APP_PASSWORD=

# AI categorization (ADR-0008). All optional. Leave AI_PROVIDER unset and the
# feature is OFF — a fresh install makes zero external calls.
#   gemini = external (requires GEMINI_API_KEY; the benchmark GO model
#            gemini-flash-latest is used, not env-selectable)
#   ollama = zero-egress local mode (no gate-clearing local model yet — see
#            docs/ai-categorization-benchmark-phase3.md §4)
#   off / unset = disabled
# gemini selected without a key resolves to off (never errors at call time).
AI_PROVIDER=

# Gemini API key (only redacted merchant descriptors ever reach this API, ADR-0008).
# AI Studio: https://aistudio.google.com/apikey — rate limits/pricing per billing tier.
GEMINI_API_KEY=

# Ollama zero-egress mode (used only when AI_PROVIDER=ollama). Defaults shown.
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Path to Chromium/Chrome executable (required for puppeteer-core)
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux: /usr/bin/chromium-browser
# Docker: /usr/bin/chromium (set automatically in Dockerfile)
CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
